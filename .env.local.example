# Server-only. Base URL of the PHÖNIX Dart (shelf) backend.
# Defaults to the production Railway deployment if unset.
# For local development against a locally running backend, uncomment:
# PHOENIX_BACKEND_URL=http://localhost:8080
PHOENIX_BACKEND_URL=https://energetic-peace-production-b6f2.up.railway.app

# Server-only. Legacy static admin token, separate from the Control Center
# session-cookie mechanism above. Predates the Control Center — it's the
# same shared secret the Flutter Model Lab admin screen uses — and protects
# /api/admin/football/* and /api/admin/model-lab/* on the backend. Used only
# by the Football proxy routes (lib/legacyBackend.ts). Never exposed to the
# browser.
PHOENIX_ADMIN_TOKEN=
